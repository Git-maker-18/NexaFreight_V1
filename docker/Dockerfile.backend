# syntax=docker/dockerfile:1
FROM python:3.11-slim AS builder

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM python:3.11-slim

WORKDIR /app

# Security: Create non-root system group and user
RUN groupadd --system --gid 1001 nexafreight && \
    useradd --system --uid 1001 --gid nexafreight --create-home --home-dir /home/nexafreight nexafreight

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src ./src
COPY models ./models
COPY migrations ./migrations
COPY alembic.ini .
COPY docker/entrypoint.backend.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Create runtime directories for data, models, logs and ensure nexafreight ownership
RUN mkdir -p /app/data /app/models /app/logs && \
    chown -R nexafreight:nexafreight /app /home/nexafreight

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
USER nexafreight

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "nexafreight.main:app", "--host", "0.0.0.0", "--port", "8000"]
